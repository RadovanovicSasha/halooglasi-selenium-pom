# Local credentials - never commit
.env

# Build output
target/

# Allure commandline, auto-downloaded locally by the allure-maven plugin
.allure/

# Generated test reports - keep the folder, never commit its contents
reports/*
!reports/.gitkeep

# Local failure evidence - keep the folder, never commit its contents
screenshots/*
!screenshots/.gitkeep

# IDE
.idea/

# Claude Code local settings
.claude/

# Logs
*.log
